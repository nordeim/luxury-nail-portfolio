# Database (tooling contract — the SPA itself persists to localStorage)
# npm run db:setup materializes this URL as a real SQLite file
# (schema + catalog + demo-user digests; node:sqlite, zero deps).
DATABASE_URL="file:../db/custom.db"

# Absolute origin used by the SEO layer (canonical/og:url defaults in
# index.html, robots.txt/sitemap.xml generation, and per-route head writes).
# Must stay in sync across:
#   - index.html static head fallbacks
#   - src/lib/seo.ts (import.meta.env.VITE_SITE_URL)
#   - scripts/generate-sitemap.mjs (process.env.VITE_SITE_URL)
# After changing it: run `node scripts/generate-sitemap.mjs` and commit the
# refreshed public/ artifacts.
# VITE_SITE_URL="http://localhost:4173"
